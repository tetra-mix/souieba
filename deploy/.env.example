# --- Tailscale ---
# Settings → Keys で発行した Auth key（tag:souieba 付き）
TS_AUTHKEY=tskey-auth-xxxxxxxx
TS_HOSTNAME=souieba

# --- Souieba ---
# クライアントから見た URL（Tailscale なら https://<TS_HOSTNAME>.<tailnet>.ts.net）
SOUIEBA_PUBLIC_URL=https://souieba.your-tailnet.ts.net
SOUIEBA_INSTANCE_NAME=Souieba
# member: メンバー全員が招待できる / admin: 管理者だけ
SOUIEBA_INVITE_BY=member
SOUIEBA_POST_GRACE_MINUTES=10
SOUIEBA_POST_RETENTION_DAYS=14

# WireGuard 構成で http を使う場合だけ（VPN が通信路を暗号化している前提）
# SOUIEBA_PUBLIC_URL=http://10.8.0.1:8080
# SOUIEBA_ALLOW_HTTP=1
