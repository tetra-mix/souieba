# --- インターネット公開（compose.public.yml）---
# この VPS の IP に向けた DNS の A / AAAA レコードを先に作っておく
SOUIEBA_DOMAIN=souieba.example.com
SOUIEBA_INSTANCE_NAME=Souieba
# グループへの招待: member ならメンバー全員 / admin なら各グループの owner だけ
SOUIEBA_INVITE_BY=member
# グループの作成: member なら全員 / admin なら管理者だけ
SOUIEBA_GROUP_CREATE_BY=member
SOUIEBA_POST_GRACE_MINUTES=10
SOUIEBA_POST_RETENTION_DAYS=30
