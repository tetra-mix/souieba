# Let's Encrypt の証明書を自動で取得・更新する（80・443 番を開けておく）
{$SOUIEBA_DOMAIN} {
	# apps/server/src/app.ts の POST_BODY_LIMIT（256KB）と揃える。ほかの経路はアプリ側で 16KB に絞っている
	request_body {
		max_size 256KB
	}
	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
	}
	# X-Forwarded-For は Caddy が実際の接続元で付け直す（クライアントが送った値は信頼しない）
	reverse_proxy server:8080
}
