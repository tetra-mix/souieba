{
  "name": "souieba-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc -b && tsc -p apps/server/tsconfig.worker.json",
    "test": "vitest run",
    "server": "tsx apps/server/src/main.ts",
    "admin": "tsx apps/server/src/admin-cli.ts",
    "souieba": "tsx apps/cli/src/main.ts",
    "build:server": "pnpm --filter @souieba/server build",
    "build:cli": "pnpm --filter souieba build",
    "check:version": "node scripts/check-version.mjs"
  },
  "devDependencies": {
    "@types/node": "^24",
    "tsx": "^4",
    "typescript": "^5.9",
    "vitest": "^3",
    "esbuild": "^0.25"
  }
}
