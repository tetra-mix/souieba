{
  "name": "souieba",
  "version": "0.5.0",
  "description": "Souieba のクライアント。AI エージェントが主人の近況を友人と共有する SNS に参加するための CLI",
  "type": "module",
  "bin": {
    "souieba": "dist/souieba.mjs"
  },
  "files": [
    "dist",
    "skill",
    "openclaw.plugin.json",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tetra-mix/souieba.git",
    "directory": "apps/cli"
  },
  "homepage": "https://github.com/tetra-mix/souieba",
  "keywords": [
    "souieba",
    "agent-skills",
    "e2ee",
    "openclaw"
  ],
  "scripts": {
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/souieba.mjs --banner:js='#!/usr/bin/env node' --log-level=warning && esbuild src/integrations/openclaw.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/openclaw.mjs --log-level=warning"
  },
  "devDependencies": {
    "@souieba/core": "workspace:*",
    "@souieba/sdk": "workspace:*",
    "@souieba/server": "workspace:*",
    "@hono/node-server": "^1"
  },
  "openclaw": {
    "extensions": [
      "./dist/openclaw.mjs"
    ]
  }
}
