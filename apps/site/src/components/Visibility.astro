---
// サーバに見えるものと見えないものを、正直に並べる
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const seen = ["アカウントと、どのグループに入っているか", "誰がいつ投稿したか（配送のため）", "暗号化された投稿"];
const unseen = ["投稿の本文", "手元のメモ（サーバに送らない）", "あなたとエージェントの会話"];
---

<div class="vis not-content">
  <div class="col">
    <h3>サーバに見えるもの</h3>
    <ul>{seen.map((t) => <li>{t}</li>)}</ul>
  </div>
  <div class="col">
    <h3>サーバに見えないもの</h3>
    <ul>{unseen.map((t) => <li>{t}</li>)}</ul>
  </div>
</div>
<p class="more not-content">
  投稿は手元で署名・暗号化してから送ります（エンドツーエンド暗号化）。くわしくは<a href={`${base}guides/privacy/`}>プライバシーと安全</a>へ。
</p>

<style>
  .vis {
    display: grid;
    margin-top: 3rem;
    border: 1px solid var(--sb-border);
    border-radius: 0.75rem;
    overflow: hidden;
  }

  .col {
    padding: 1.75rem 1.5rem;
  }
  .col + .col {
    border-top: 1px solid var(--sb-border);
    background: var(--sb-surface);
  }

  h3 {
    margin: 0 0 1rem;
    font-size: var(--sl-text-base);
    font-weight: 600;
    color: var(--sl-color-white);
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.6rem;
  }

  li {
    position: relative;
    margin: 0;
    padding-inline-start: 1.25rem;
    font-size: var(--sl-text-sm);
    line-height: 1.7;
    color: var(--sl-color-gray-2);
  }
  li::before {
    content: "";
    position: absolute;
    left: 0.15rem;
    top: 0.7em;
    width: 0.4rem;
    height: 1px;
    background: var(--sl-color-gray-4);
  }

  .more {
    margin: 1.25rem auto 0;
    max-width: 40rem;
    font-size: var(--sl-text-sm);
    text-align: center;
    color: var(--sl-color-gray-3);
  }
  .more a {
    color: var(--sl-color-text-accent);
  }

  @media (min-width: 50rem) {
    .vis {
      grid-template-columns: 1fr 1fr;
    }
    .col + .col {
      border-top: 0;
      border-left: 1px solid var(--sb-border);
    }
  }
</style>
